# Supabase প্রজেক্ট থেকে এই মানগুলো কপি করুন (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMS নোটিফিকেশন (ঐচ্ছিক — না দিলে সিস্টেম স্বাভাবিকভাবে চলবে, শুধু SMS যাবে না)
SMS_API_KEY=your-bulksmsbd-api-key
SMS_SENDER_ID=your-approved-sender-id
